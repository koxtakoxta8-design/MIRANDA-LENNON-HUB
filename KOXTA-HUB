local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer
local WORKER = "https://koxta-couter.darianmaizena.workers.dev"

local usuario = Player.Name
local juego = game.Name
local placeId = tostring(game.PlaceId)
local jobId = game.JobId

if jobId == "" then
    jobId = "Servidor privado"
end

local url =
    WORKER ..
    "/?user=" .. HttpService:UrlEncode(usuario) ..
    "&game=" .. HttpService:UrlEncode(juego) ..
    "&place=" .. placeId ..
    "&job=" .. HttpService:UrlEncode(jobId)

local ok, response = pcall(function()
    return request({
        Url = url,
        Method = "GET"
    })
end)

if ok and response then
    print("✅ TRACKER ENVIADO")
    print("Usuario:", usuario)
    print("Juego:", juego)
    print("Place ID:", placeId)
    print("Job ID:", jobId)
    print("Status:", response.StatusCode)
else
    warn("❌ ERROR DEL TRACKER:", response)
end
